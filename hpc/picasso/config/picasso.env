# PyEXPINT / Picasso persistent configuration.
# Canonical versioned file: $HOME/pyexpint_toms/repo/hpc/picasso/config/picasso.env

export PYEXPINT_HOME_ROOT="${PYEXPINT_HOME_ROOT:-$HOME/pyexpint_toms}"
export PYEXPINT_FSCRATCH_ROOT="${PYEXPINT_FSCRATCH_ROOT:-$FSCRATCH/pyexpint_toms}"

# Development mode now; production mode later: sif.
export PYEXPINT_RUNTIME="${PYEXPINT_RUNTIME:-source}"

# Picasso CPU benchmark policy.
export PYEXPINT_PARTITION="${PYEXPINT_PARTITION:-cpu_parti}"
export PYEXPINT_CONSTRAINT="${PYEXPINT_CONSTRAINT:-intel}"
export PYEXPINT_ARRAY_THROTTLE="${PYEXPINT_ARRAY_THROTTLE:-8}"
export PYEXPINT_MEM="${PYEXPINT_MEM:-16G}"
export PYEXPINT_TIME="${PYEXPINT_TIME:-04:00:00}"

# PyEXPINT 0.8.x requires Python >= 3.11.  Do not use the old default Anaconda
# module (Python 3.8.5) for this source-mode campaign.
export PYEXPINT_PYTHON_MODULE="${PYEXPINT_PYTHON_MODULE:-python/3.11.4}"
export PYEXPINT_PYTHON="${PYEXPINT_PYTHON:-python3}"

# Declared package requirements; checked before staging and inside each job.
export PYEXPINT_MIN_PYTHON="${PYEXPINT_MIN_PYTHON:-3.11}"
export PYEXPINT_MIN_NUMPY="${PYEXPINT_MIN_NUMPY:-1.24}"
export PYEXPINT_MIN_SCIPY="${PYEXPINT_MIN_SCIPY:-1.10}"

# Final-production container fields (inactive while runtime=source).
export PYEXPINT_SIF_NAME="${PYEXPINT_SIF_NAME:-pyexpint_toms.sif}"
export PYEXPINT_APPTAINER="${PYEXPINT_APPTAINER:-apptainer}"


# Final TOMS timing protocol: one job, one core, balanced sequential design.
export PYEXPINT_TOMS_BLOCKS="${PYEXPINT_TOMS_BLOCKS:-12}"
export PYEXPINT_TOMS_MEM="${PYEXPINT_TOMS_MEM:-4G}"
export PYEXPINT_TOMS_TIME="${PYEXPINT_TOMS_TIME:-00:30:00}"
